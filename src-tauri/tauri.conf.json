{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "peeps",
  "version": "0.1.1",
  "identifier": "app.peeps.desktop",
  "build": {
    "beforeDevCommand": "npm run build:hook && npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build:hook -- --release && npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "macOSPrivateApi": true,
    "windows": [
      {
        "label": "main",
        "title": "peeps",
        "width": 360,
        "height": 48,
        "decorations": false,
        "transparent": true,
        "alwaysOnTop": true,
        "resizable": false,
        "skipTaskbar": true,
        "shadow": false,
        "visibleOnAllWorkspaces": true,
        "acceptFirstMouse": true
      },
      {
        "label": "home",
        "title": "peeps",
        "url": "index.html?view=home",
        "width": 1080,
        "height": 720,
        "minWidth": 880,
        "minHeight": 600,
        "visible": false,
        "center": true,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self' data:"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "externalBin": ["binaries/peeps-hook"],
    "category": "DeveloperTool",
    "shortDescription": "A dumpling for every product you run, living in your notch.",
    "windows": {
      "nsis": {
        "installerIcon": "icons/icon.ico"
      }
    }
  },
  "plugins": {
    "updater": {
      "endpoints": [
        "https://github.com/TheSscarletSkies/peeps/releases/latest/download/latest.json"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IENFNUM4MUYyMzE3RDdGNDIKUldSQ2YzMHg4b0Zjem5MdGQyT0VXOGQ2MkRVOHc1bytMN2lkNEpjcGVMN2FkUXZyc2lUcTJLUVgK",
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
